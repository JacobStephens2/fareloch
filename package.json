{
  "license": "MIT",
  "name": "fareloch",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:dashboard-summary": "node scripts/test-dashboard-summary.mjs",
    "test:android-upgrade": "node scripts/test-android-upgrade.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:android": "VITE_API_BASE=https://fareloch.app/api npm run build -- --mode android && npx cap sync android",
    "generate:icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.1",
    "@capacitor/status-bar": "^8.0.2",
    "chart.js": "^4.4.0",
    "html5-qrcode": "^2.3.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "canvas": "^3.2.2",
    "jsdom": "^26.1.0",
    "playwright-core": "1.58.2",
    "sharp": "0.35.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^3.2.7",
    "workbox-build": "7.4.0"
  }
}
